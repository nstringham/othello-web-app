{
  "name": "othello-web-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run wasm-dev && vite",
    "dev:host": "pnpm run wasm-dev && vite --host",
    "build": "pnpm run wasm-release && tsc && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "wasm-dev": "wasm-pack build ./rust-othello --target web --dev --debug",
    "wasm-release": "wasm-pack build ./rust-othello --target web --release"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "comlink": "^4.4.2",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.1.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11"
    },
    "runtime": {
      "name": "node",
      "version": ">=26"
    }
  }
}
